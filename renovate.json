{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "vulnerabilityAlerts": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Pin container images to digests.",
      "matchCategories": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "One PR for everything that is not a major bump. Majors stay on their own, and a security update still opens its own PR regardless of this rule.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "bump"
      ],
      "groupName": "all non-major dependencies"
    },
    {
      "description": "Bun is pinned twice, in mise.toml (mise manager) and in application.properties for Quinoa (custom manager); BunVersionPinTest fails if they differ, so both always move in one PR, majors included.",
      "matchDatasources": [
        "github-releases"
      ],
      "matchPackageNames": [
        "oven-sh/bun"
      ],
      "groupName": "bun"
    }
  ],
  "customManagers": [
    {
      "description": "Liberica JDK pinned in mise.toml as liberica-<version>. mise's Liberica ids are BellSoft's release versions with that prefix, so BellSoft's own release list only proposes ids mise can install.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^mise\\.toml$/"
      ],
      "matchStrings": [
        "java\\s*=\\s*\"liberica-(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "liberica-jdk",
      "datasourceTemplate": "custom.liberica",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+)(?:\\.(?<revision>\\d+))?)?\\+\\d+$"
    },
    {
      "description": "The Prince of Space version sits inside Spotless's configuration, where the Maven manager does not look.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^pom\\.xml$/"
      ],
      "matchStrings": [
        "<princeOfSpace>\\s*<version>(?<currentValue>[^<]+)</version>"
      ],
      "depNameTemplate": "io.github.agustafson.princeofspace:prince-of-space-core",
      "datasourceTemplate": "maven"
    },
    {
      "description": "Quinoa's Bun pin in application.properties. Same datasource, package and version extraction as Renovate's mise manager uses for mise.toml's bun, so both propose the same versions.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^src/main/resources/application\\.properties$/"
      ],
      "matchStrings": [
        "quarkus\\.quinoa\\.package-manager-install\\.bun-version=(?<currentValue>\\S+)"
      ],
      "depNameTemplate": "bun",
      "packageNameTemplate": "oven-sh/bun",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^bun-v(?<version>\\S+)"
    }
  ],
  "customDatasources": {
    "liberica": {
      "description": "BellSoft's GA Liberica JDK releases for linux x64; one release per version string.",
      "defaultRegistryUrlTemplate": "https://api.bell-sw.com/v1/liberica/releases?bundle-type=jdk&os=linux&arch=x86&bitness=64&package-type=tar.gz&release-type=all",
      "format": "json",
      "transformTemplates": [
        "{ \"releases\": $map($[GA = true], function($r) { { \"version\": $r.version } }) }"
      ]
    }
  }
}
