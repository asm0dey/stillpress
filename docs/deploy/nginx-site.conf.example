# TLS lines (listen 443 ssl, ssl_certificate, ...) go in this server block too.
# Stillpress trusts X-Forwarded-* only from STILLPRESS_TRUSTED_PROXIES (default 127.0.0.1,[::1]); it must include
# the address nginx connects from, e.g. the Docker bridge 172.17.0.0/16 when nginx runs in Docker.
# Server-level add_header lines (HSTS and the like) are not inherited by the include's locations, which set their
# own headers: put them in the http {} block or repeat them in each location.
# nginx needs read access to the data directory's output/; the current symlink is relative, so output/ may be mounted anywhere.
server {
    listen 80;
    server_name example.org;

    # generated once: stillpress nginx-config > /etc/nginx/stillpress.conf
    include /etc/nginx/stillpress.conf;
}
