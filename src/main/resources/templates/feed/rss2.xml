{@site.asm0dey.stillpress.publish.views.SiteView site}
{@java.lang.String selfUrl}
{@java.lang.String lastBuildDate}
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:content="http://purl.org/rss/1.0/modules/content/" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:atom="http://www.w3.org/2005/Atom">
<channel>
<title>{site.title}</title>
<atom:link href="{selfUrl}" rel="self" type="application/rss+xml"/>
<link>{site.homeUrl}</link>
<description>{site.description}</description>
<lastBuildDate>{lastBuildDate}</lastBuildDate>
<language>{site.language}</language>
{#for item in items}
<item>
<title>{item.title}</title>
<link>{item.absoluteUrl}</link>
<dc:creator>{item.authorName}</dc:creator>
<pubDate>{item.pubDate}</pubDate>
{#for t in item.categories}<category>{t.name}</category>{/for}
{#for t in item.tags}<category>{t.name}</category>{/for}
<guid isPermaLink="false">{item.guid}</guid>
<description>{item.excerptHtml}</description>
<content:encoded><![CDATA[{item.contentCdata.raw}]]></content:encoded>
</item>
{/for}
</channel>
</rss>
